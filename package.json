{
  "name": "plant-doctor-backend",
  "version": "1.0.0",
  "description": "Secure backend for plant doctor OpenAI API proxy",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build:css": "tailwindcss -c tailwind.config.js -i src/styles.css -o public/styles.css --minify",
    "build:assets": "node scripts/copy-static-assets.js",
    "build": "npm run build:css && npm run build:assets",
    "check": "node --check server.js && node --check public/app.js && node --check public/translations.js && node --test"
  },
  "dependencies": {
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "lucide": "^1.37.0",
    "multer": "2.3.0",
    "mysql2": "3.24.2",
    "node-fetch": "2.7.0",
    "nodemailer": "^9.0.6",
    "openai": "6.49.0"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
